# --- Servidor ---
PORT=3000

# --- Base de datos ---
DATABASE_URL="file:./dev.db"

# --- Claude (Anthropic) ---
# Esta es TU cuenta: se usa para todos los negocios-cliente (vos revendés el uso).
ANTHROPIC_API_KEY=

# --- Meta (una sola app tuya, un solo webhook para todos los clientes) ---
# Verify token que vos elegís al configurar el webhook en Meta for Developers.
META_WEBHOOK_VERIFY_TOKEN=
# App Secret de tu app de Meta (App settings > Basic), usado por WhatsApp.
META_APP_SECRET=
# Instagram app secret (distinto al de arriba): la API directa de Instagram
# (Instagram Login) firma sus webhooks con este secret propio. Se ve en
# Use cases > Manage messaging & content on Instagram > API setup with
# Instagram login > "Instagram app secret".
META_INSTAGRAM_APP_SECRET=

# Nota: los números de WhatsApp / cuentas de Instagram de cada negocio-cliente,
# junto con sus access tokens y su system prompt, se guardan en la base de datos
# (tabla Tenant), no en variables de entorno. Ver scripts/create-tenant.js.
