{
  "name": "whatsapp-instagram-bot",
  "version": "1.0.0",
  "description": "Webhook server que conecta WhatsApp Cloud API e Instagram Messaging API con la API de Claude",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
